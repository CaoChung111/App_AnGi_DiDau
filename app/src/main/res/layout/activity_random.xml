<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.random.RandomActivity">

    <!-- Top Header: Tiêu đề + icon chuông -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp">

            <!-- App Name: Đi Đâu Ăn Gì -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đi Đâu Ăn Gì"
                android:textColor="@color/primary_container"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Notification Bell -->
            <ImageView
                android:id="@+id/ivNotificationRandom"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_dialog_info"
                android:contentDescription="Thông báo"
                app:tint="@color/on_surface"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section Title: Hôm Nay Ăn Gì? + số quán -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hôm Nay Ăn Gì?"
                    android:textColor="@color/on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvNearbyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32 Quán Gần Đây"
                    android:textColor="@color/secondary"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Chip: Dưới 100k -->
                    <TextView
                        android:id="@+id/chipBudget"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab_selected"
                        android:paddingHorizontal="16dp"
                        android:gravity="center"
                        android:text="🍽 Dưới 100k"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <!-- Chip: 2km -->
                    <TextView
                        android:id="@+id/chipDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:paddingHorizontal="16dp"
                        android:gravity="center"
                        android:text="📍 2km"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"/>

                    <!-- Chip: Tất cả món -->
                    <TextView
                        android:id="@+id/chipAllFood"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_tab_unselected"
                        android:paddingHorizontal="16dp"
                        android:gravity="center"
                        android:text="🍴 Tất cả món"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- ===================== -->
            <!-- TAB SELECTOR: 2 mục -->
            <!-- ===================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_tab_unselected"
                android:padding="4dp">

                <!-- Tab 1: Chọn Ăn Gì -->
                <TextView
                    android:id="@+id/tabEat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab_selected"
                    android:gravity="center"
                    android:text="🍜 Ăn Gì"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <!-- Tab 2: Chọn Đi Đâu -->
                <TextView
                    android:id="@+id/tabGo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="📍 Đi Đâu"
                    android:textColor="@color/secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- ===================== -->
            <!-- SPIN WHEEL Container  -->
            <!-- ===================== -->
            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <!-- Vòng quay tự vẽ (Custom View sẽ render vào đây) -->
                <com.example.angi_didau.ui.random.SpinWheelView
                    android:id="@+id/spinWheelView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <!-- Mũi tên chỉ ở trên cùng (trỏ vào vòng quay) -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-4dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/primary_container"/>

                <!-- Nút tâm vòng quay -->
                <FrameLayout
                    android:id="@+id/btnCenterSpin"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_primary"
                    android:elevation="4dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_spin"
                        android:contentDescription="Quay"/>

                </FrameLayout>

            </FrameLayout>

            <!-- Kết quả hiển thị -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Nhấn nút bên dưới để bắt đầu xoay!"
                android:textColor="@color/secondary"
                android:textSize="14sp"/>

            <!-- Spin Now Button -->
            <Button
                android:id="@+id/btnSpinNow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_spin_btn"
                android:text="Spin Now"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:elevation="4dp"/>

            <!-- Spacer bottom -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Nav -->
    <include layout="@layout/layout_bottom_nav"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
